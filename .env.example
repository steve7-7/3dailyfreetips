# Required: PostgreSQL connection string used by Drizzle and the app.
# For hosted PostgreSQL providers such as Supabase, include sslmode=require when required.
DATABASE_URL=postgresql://postgres:password@localhost:5432/app_db

# Required for JWT session signing. Use a long random value in production.
JWT_SECRET=replace-with-a-long-random-secret

# Optional: Supabase client/auth integration.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Paystack live payments. Omit for mock mode.
PAYSTACK_SECRET_KEY=sk_test_or_live_xxx

# Optional: app URL used by callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000
